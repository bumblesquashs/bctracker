{
    "name": "Edmonton Transit Service",
    "website": "https://www.edmonton.ca/edmonton-transit-system-ets",
    "default_system": "edmonton",
    "liveries": {
        "ets": {
            "name": "ETS"
        },
        "spruce-grove": {
            "name": "Spruce Grove"
        },
        "st-albert-stripes": {
            "name": "St Albert Stripes"
        },
        "st-albert-green": {
            "name": "St Albert Green"
        },
        "fort-saskatchewan": {
            "name": "Fort Saskatchewan"
        },
        "strathcona": {
            "name": "Strathcona County"
        }
    },
    "order_defaults": {
