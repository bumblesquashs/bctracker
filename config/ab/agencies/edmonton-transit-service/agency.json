{
    "name": "Edmonton Transit Service",
    "website": "https://www.edmonton.ca/edmonton-transit-system-ets",
    "default_system": "edmonton",
    "order_defaults": {
        "livery": "ets",
        "amenities": {
            "accessible": true,
            "air_conditioned": true,
            "cctv": true
        }
    },
    "config": {
        "accurate_seconds": false,
        "default_model_category": "bus",
        "gtfs_url": "https://gtfs.edmonton.ca/TMGTFSRealTimeWebService/GTFS/gtfs.zip",
        "invalid_realtime_percentage": 0.5,
        "max_invalid_positions": 20,
        "realtime_url": "http://gtfs.edmonton.ca/TMGTFSRealTimeWebService/Vehicle/VehiclePositions.pb"
    }
}
